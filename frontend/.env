# Production backend on Railway (публичный HTTPS-URL)
API_BASE_URL=https://finance-app-production-4362.up.railway.app/api/v1
# Локальная разработка — раскомментируй нужную строку и закомментируй прод выше:
# Web / iOS-симулятор:      API_BASE_URL=http://localhost:9090/api/v1
# Android-эмулятор (loopback): API_BASE_URL=http://10.0.2.2:9090/api/v1

# Google Sign-In. Dev-режим (true) не требует реального Google-проекта.
# Для прода: GOOGLE_DEV_MODE=false и заполнить GOOGLE_CLIENT_ID (web/server OAuth client).
GOOGLE_DEV_MODE=true
GOOGLE_CLIENT_ID=
FCM_DEV_MODE=true
